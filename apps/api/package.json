  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "DOCKER_HOST=unix:///var/run/docker.sock NODE_ENV=test SUPABASE_JWT_SECRET=test-secret jest --config ./test/jest-e2e.json --forceExit",
    "test:e2e:watch": "NODE_ENV=test jest --watch --config ./test/jest-e2e.json --forceExit",
    "test:e2e:debug": "NODE_ENV=test jest --runInBand --detectOpenHandles --config ./test/jest-e2e.json --forceExit",
    "typecheck": "tsc --noEmit"
  },
