# Dockerfile.post-worker (for NestJS post-worker)
FROM uploader-base

# Copy root package management files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy app and package manifests
COPY apps/api/package.json ./apps/api/
COPY apps/post-worker/package.json ./apps/post-worker/
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/
COPY packages/db/tsconfig.json ./packages/db/
COPY packages/db/src ./packages/db/src/
COPY packages/db/prisma ./packages/db/prisma/
COPY packages/ui/package.json ./packages/ui/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config ./packages/typescript-config/

# Install all dependencies
RUN pnpm install --filter=post-worker...

# Generate Prisma client
RUN pnpm --filter @repo/db exec -- prisma generate

# Build the shared db package
RUN pnpm --filter @repo/db build

# Copy the rest of the source code
COPY . .

# The command in docker-compose.yml will override this,
# but this is a good default for running the container directly.
CMD ["pnpm", "dev", "--filter=post-worker"]