# Dockerfile.debug (for NestJS post-worker)
FROM node:20-slim

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Install build tools for native addons and openssl for Prisma
RUN apt-get update && apt-get install -y python3 make g++ openssl curl procps iputils-ping && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy the full monorepo context
COPY . .

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Generate Prisma client - IMPORTANT!
RUN pnpm --filter db run prisma:generate

# Build the post-worker and its dependencies
RUN pnpm --filter post-worker... build

# Start the post-worker
CMD ["pnpm", "--filter=post-worker", "run", "dev"]