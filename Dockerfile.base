# Dockerfile.base
FROM node:20-slim

# Install pnpm
RUN npm install -g pnpm

# Install build tools for native addons and curl for health checks
RUN apt-get update && apt-get install -y python3 make g++ curl openssl procps && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app