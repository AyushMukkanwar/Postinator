FROM node:20-slim

# Install pnpm
RUN npm install -g pnpm

# Install build tools for native addons and curl for health checks
RUN apt-get update && apt-get install -y python3 make g++ curl openssl procps && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy root package management files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy app and package manifests
COPY apps/api/package.json ./apps/api/
COPY apps/post-worker/package.json ./apps/post-worker/
COPY apps/web/package.json ./apps/web/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config ./packages/typescript-config/
COPY packages/database/package.json ./packages/database/

# Install dependencies for the api app
RUN pnpm install --frozen-lockfile

# Copy database package
COPY packages/database ./packages/database

# Generate Prisma client and build database package
RUN pnpm --filter @repo/database db:generate && pnpm --filter @repo/database build

# Copy the rest of the source code
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/
COPY apps/api/tsconfig.build.json ./apps/api/
COPY apps/api/nest-cli.json ./apps/api/
COPY tsconfig.json ./

# Build the api
RUN pnpm --filter api build

# Expose port
EXPOSE 3001 9229

# Start the api
CMD ["node", "apps/api/dist/main.js"]