FROM node:20-slim

# Install pnpm
RUN npm install -g pnpm

# Install build tools for native addons and curl for health checks
RUN apt-get update && apt-get install -y python3 make g++ curl openssl procps && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy root package management files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy app and package manifests
COPY apps/api/package.json ./apps/api/
COPY apps/post-worker/package.json ./apps/post-worker/
COPY apps/web/package.json ./apps/web/
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config ./packages/typescript-config/
COPY packages/database/package.json ./packages/database/

# Install all dependencies
RUN pnpm install --filter=post-worker...

# Copy database package
COPY packages/database ./packages/database

# Generate Prisma client and build database package
RUN pnpm --filter @repo/database db:generate && pnpm --filter @repo/database build

# Copy the post-worker source code
COPY apps/post-worker/src ./apps/post-worker/src
COPY apps/post-worker/tsconfig.json ./apps/post-worker/
COPY apps/post-worker/tsconfig.build.json ./apps/post-worker/
COPY apps/post-worker/nest-cli.json ./apps/post-worker/
COPY tsconfig.json ./

# Build the post-worker
RUN pnpm --filter post-worker build

# Start the post-worker in production mode
CMD ["node", "apps/post-worker/dist/main.js"]